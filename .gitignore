# ==========================================
**/obj/
obj/
*.o
*.d
*.lst
*.map
*.elf
*.hex
*.bin
*.out

# MounRiver Studio / Eclipse 本地 IDE 缓存
.mrs/
.metadata/
*.launch.backup

# ==========================================
# Python 运行环境、缓存与打包产物
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# 打包临时产物 (PyInstaller / setuptools)
build/
dist/
*.spec
*.egg-info/
.eggs/

# 虚拟环境
venv/
.venv/
env/
ENV/

# ==========================================
# 桌面可执行文件与日志/数据产物
# ==========================================
*.exe
*.dll

# 上位机配置文件 (本地记忆个性化设置，不纳入版本控制)
config.json
**/config.json

# 上位机实时采集与分析保存的数据流文件
*.csv
*.csv.gz
*.log

# ==========================================
# 操作系统与通用编辑器配置
# ==========================================
Thumbs.db
Desktop.ini
.DS_Store
.idea/
